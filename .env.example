APP_NAME="Company Software"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# The default channel, used by unhandled exceptions and by any Log:: call that
# forgot its section channel. 'unrouted' keeps those visible in their own file;
# 'errors' puts error and above into laravel.log.
LOG_STACK=unrouted,errors
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Per-section log levels. Default to info in every environment; set a section
# to debug to get its step-by-step detail. Deliberately independent of
# LOG_LEVEL so no single value can silence every channel at once.
LOG_LEVEL_WHOLESALE_OUT=info
LOG_LEVEL_WHOLESALE_IN=info
LOG_LEVEL_EXPORTS=info
LOG_LEVEL_IMPORTS=info
LOG_LEVEL_DISCOGS=info
LOG_LEVEL_STOCK=info
LOG_LEVEL_USERS=info
LOG_LEVEL_UNROUTED=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# Forwarded host ports, change them if they clash with other containers running on the host.
FORWARD_MAILPIT_PORT=1026
FORWARD_MAILPIT_DASHBOARD_PORT=8026
FORWARD_DB_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Discogs marketplace integration (order sync and listings).
# The token and username belong to the seller account; the timezone is the shop
# timezone used to date the synced sales. Commented values are the defaults.
DISCOGS_TOKEN=
DISCOGS_USERNAME=
# DISCOGS_API_URL=https://api.discogs.com
# DISCOGS_USER_AGENT="InventoryApp/0.1 +https://example.com"
# DISCOGS_TIMEZONE=Europe/Rome

# Sentry error tracking, disabled while the DSN is empty
SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Cloudflare Turnstile on the login page, enabled only when both keys are set
TURNSTILE_SITEKEY=
TURNSTILE_SECRETKEY=

VITE_APP_NAME="${APP_NAME}"
